# 复制为 server/.env 后填写。控制台：https://console.cloud.tencent.com/cam/capi
# AppId 在「账号信息」页获取（不是微信 AppId）
SOE_APPID=
SOE_SECRET_ID=
SOE_SECRET_KEY=

# 服务端口
PORT=8787

# 本地/内网调试：允许把永久密钥下发给浏览器（仅限本机 / 内网调试，方便本地真评）
# 1 = 允许下发永久密钥（仅调试，禁止用于生产环境）
# 0 / 不设置 = 生产模式，自动走 STS 临时密钥（永久密钥留服务端，浏览器只拿临时三件套）
SOE_ALLOW_STATIC=0

# 可选：显式设为任意值可强制走 STS 临时密钥（即便上方 SOE_ALLOW_STATIC 误设为 1）。
# 生产路径用主密钥直接调 CAM GetFederationToken 换临时凭证，无需 RoleArn。
# STS SDK 已在 package.json optionalDependencies 声明（tencentcloud-sdk-nodejs-sts）。
SOE_STS_ROLE_ARN=

# CORS 允许的来源，生产请改成具体域名，如 https://h5.eanavi.com
SOE_ALLOW_ORIGIN=*

# ── 语音合成 TTS：题目听力音频由服务端合成（详见 README 第八章） ─────────────
# 与智聆共用同一对密钥（SOE_SECRET_ID / SOE_SECRET_KEY）；需要独立密钥再填下面两项
TTS_SECRET_ID=
TTS_SECRET_KEY=

# 1 = 启用 /api/tts/audio（默认）；0 = 关闭（接口返回 503）
TTS_ENABLED=1

# 音色：英文音色只有 501008 WeJames（男）/ 501009 WeWinny（女）/ 101050 WeJack（精品男）
# 超自然大模型音色里的中英双语童声（403000 女童 / 603002 男童）可区分 Boy/Girl，
# 但单价约为大模型音色的 5.4 倍、默认并发 10 路，按需切换。
TTS_VOICE_MALE=501008
TTS_VOICE_FEMALE=501009
TTS_VOICE_NARRATOR=501009

# 语速 [-2, 6]，0 = 1.0 倍速；采样率留空 = 大模型音色 24k / 精品音色 16k
TTS_SPEED=0
TTS_SAMPLE_RATE=

# 磁盘缓存：同一文本只合成一次（含 .json 审计元数据），超上限按 LRU 淘汰到 80%
TTS_CACHE_DIR=.cache/tts
TTS_CACHE_MAX_MB=64

# 0 = 仅允许题库内文本（默认，防配额盗刷）；1 = 允许任意文本（调试用，慎重开启）
TTS_ALLOW_ANY_TEXT=0

# 进程内并发闸门（云端默认 20 路）与单 IP 每分钟请求上限
TTS_MAX_CONCURRENCY=4
TTS_RATE_PER_MIN=120

# 上线前必做：到 https://console.cloud.tencent.com/tts 开通语音合成，并在
# https://console.cloud.tencent.com/tts/resourcebundle 领取免费资源包
# （大模型音色 10 万字符 / 3 个月；额度用尽后 1.2 元/万字符，后付费默认关闭）
