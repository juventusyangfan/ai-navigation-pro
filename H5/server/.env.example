# 复制为 server/.env 后填写。控制台：https://console.cloud.tencent.com/cam/capi
# AppId 在「账号信息」页获取（不是微信 AppId）
SOE_APPID=
SOE_SECRET_ID=
SOE_SECRET_KEY=

# 服务端口
PORT=8787

# 本地/内网调试：允许把永久密钥下发给浏览器，使 H5 开箱即用真实密钥完成口语评测
# 1 = 允许下发（仅限本机 / 内网调试，方便本地真评）
# 0 = 拒绝下发（更安全）
# ⚠️ 生产环境务必改用 STS 临时密钥（配置 SOE_STS_ROLE_ARN，详见 server/index.mjs），
#    不要把永久密钥下发到公网浏览器。
SOE_ALLOW_STATIC=1

# 生产环境：配置角色 ARN 后走 CAM GetFederationToken 换取临时密钥
# 需要额外安装官方 SDK：npm i tencentcloud-sdk-nodejs-sts
SOE_STS_ROLE_ARN=

# CORS 允许的来源，生产请改成具体域名，如 https://h5.eanavi.com
SOE_ALLOW_ORIGIN=*
