# Admin 后台环境变量（复制为 .env 后修改）
# 会话签名密钥：生产环境务必替换为强随机串
AUTH_SECRET=dev-insecure-secret-change-me

# 数据库（SQLite，零外部依赖即可运行；换 Postgres 见 README）
DATABASE_URL="file:./dev.db"

# 公开站（front）源站，用于 /api/content/* 的 CORS 白名单
NEXT_PUBLIC_SITE_ORIGIN=https://www.eanavi.com:3000

# Admin 监听端口（front 用 3000，admin 用 3001）
PORT=3001

# 采集中心（/api/admin/collect）所需的 LLM 运行时
# 任意 OpenAI 兼容的 Chat Completions 端点；只改 base_url 即可切换
COLLECT_LLM_BASE_URL=https://api.deepseek.com
COLLECT_LLM_API_KEY=sk-1e7a404e79634295bb6d0cdb7ebd42ae
COLLECT_LLM_MODEL=deepseek-v4-pro
