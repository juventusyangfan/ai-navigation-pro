// 教AI导航 · 后台管理系统 MVP Schema
// 合并模型：Tool.paths[] → sop_paths + sop_steps；USAGES 合并进 sop_paths（is_library_pick）
// SQLite 不支持原生数组/JSON 列，数组与 JSON 均以 String(JSON.stringify) 存储，应用层用 src/lib/serialize.ts 解析。
// 换 Postgres：把 provider 改为 postgresql、相关 String 列改为 Json/枚举即可（README 有说明）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- 分类法 ----------------
model Category {
  key   String @id
  name  String
  icon  String
  phase String
  desc  String
  order Int    @default(0)
}

model Scene {
  key   String @id
  name  String
  cat   String // Category.key
  icon  String
  roles String // JSON Role[]
}

// ---------------- 内容 ----------------
model Tool {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  logo       String
  color      String
  tagline    String
  url        String
  roles      String // JSON Role[]
  scenes     String // JSON scene key[]
  subjects   String // JSON string[]
  pricing    String // Free|Freemium|Paid|Enterprise
  platform   String
  rating     Float    @default(0)
  useful     Int      @default(0) // 标记「有用」的用户数（缓存计数）
  favCount   Int      @default(0) // 收藏用户数（缓存计数）
  pros       String // JSON string[]
  cons       String // JSON string[]
  compliance String
  alts       String // JSON string[]
  status     String   @default("published") // draft|published
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  paths      SopPath[]
}

model SopPath {
  id            String    @id @default(cuid())
  toolId        String
  tool          Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  title         String
  summary       String?
  estMinutes    Int?
  level         String? // 入门|进阶|熟练
  forRole       String? // Role（用法库条目角色，seed 取自 USAGES.role）
  scene         String? // 用法库条目场景（seed 取自 USAGES.scene），保证远程与静态 USAGES 一致
  subj          String? // 用法库条目学科（seed 取自 USAGES.subj）
  isLibraryPick Boolean   @default(false)
  usefulCount   Int       @default(0)
  collectCount  Int       @default(0)
  order         Int       @default(0)
  usageId       String? // 与 front data.ts 的 USAGES.id 关联（seed 用）
  steps         SopStep[]
  litLessons    LitLessonSop[] // 通识课伴学页关联（反向关系，纯 Prisma 侧，不生成列）
}

model SopStep {
  id           String @id @default(cuid())
  pathId       String
  path         SopPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  stepOrder    Int
  goal         String?
  action       String
  prompt       String
  outputSample String
  mediaType    String? // image|video|file
  mediaUrl     String?
  mediaLabel   String?
  pitfall      String?
  tip          String?
  branch       String? // JSON {when,then}[]
}

// ---------------- 公开站账号与互动（前台注册用户） ----------------
// phone 为登录标识（系统游客账号 phone 为 null）；email 预留、注册用户可不填。
model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  name         String // 真实姓名
  passwordHash String?
  role         String   @default("teacher") // teacher|student|parent|school_admin
  status       String   @default("active") // active|disabled
  createdAt    DateTime @default(now())
  ratings      Rating[]
  favorites    Favorite[]
  notes        Note[]
  usefuls      Useful[]
  feedback     Feedback[]
  submissions  Submission[]
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  toolId    String
  score     Float
  comment   String?
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([userId, toolId])
}

// 收藏（工具 / 用法路径）：复用 refType+refId 多态，与 Useful 模型保持同一范式。
// tool 收藏 refId 存工具 slug；path 收藏 refId 存 sop_paths 的 usageId（或 id）。
// 与「有用」解耦：工具收藏只动 Tool.favCount，路径收藏只动 SopPath.collectCount。
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  refType   String // "tool" | "path"
  refId     String
  createdAt DateTime @default(now())
  @@unique([userId, refType, refId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  refType   String
  refId     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, refType, refId])
}

// 标记「有用」：按资源类型（工具 / 用法路径）记录用户对单条内容的认可
model Useful {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  refType String // "tool" | "path"
  refId   String
  createdAt DateTime @default(now())
  @@unique([userId, refType, refId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  toolId    String
  type      String
  text      String
  status    String   @default("pending") // pending|approved|rejected
  createdAt DateTime @default(now())
}

model Submission {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String
  payload      String // JSON
  status       String   @default("pending")
  reviewerId   String?
  resultToolId String? // 转工具后关联的工具 id，便于审核页回链
  createdAt    DateTime @default(now())
}

// ---------------- RBAC ----------------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  status       String   @default("active") // active|disabled
  createdAt    DateTime @default(now())
}

model Role {
  id          String       @id @default(cuid())
  key         String       @unique // super_admin|editor|reviewer|school_admin
  name        String
  admins      AdminUser[]
  permissions RolePermission[]
}

model RolePermission {
  id       String @id @default(cuid())
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String // tools|sops|taxonomy|media|ratings|feedback|submissions|users|roles|site|analytics|pushes|literacy
  action   String // read|write|delete|review
  @@unique([roleId, resource, action])
}

// 学校管理员推送（落地原"幽灵角色"价值）
model Push {
  id            String   @id @default(cuid())
  schoolAdminId String
  sopPathId     String
  target        String
  sentAt        DateTime @default(now())
}

// ---------------- AI 通识课桥接（导学层，不存官方正文） ----------------
// 合规基线：本站只存「官方 URL + 课程元信息 + 本站原创导学」。
// 本组模型刻意不提供任何可容纳官方课程正文的字段，防止后续被误用为镜像存储。

model LitModule {
  id        String   @id @default(cuid())
  slug      String   @unique              // URL 段，如 "what-is-ai"
  num       String                        // 展示序号，沿用现页面的 "一/二/三/四"
  title     String
  summary   String                        // 一句话，列表卡片用
  desc      String                        // 模块页导语，本站原创
  icon      String   @default("BookOpen") // Phosphor 图标名，前端 <Icon name={icon} />
  goal      String?                       // 学完本模块你能做到什么
  toolSlugs String   @default("[]")       // JSON string[]，模块相关工具 slug
  keywords  String   @default("[]")       // JSON string[]，SEO 关键词
  status    String   @default("draft")    // draft|published
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   LitLesson[]

  @@index([status, order])
}

model LitLesson {
  id       String    @id @default(cuid())
  moduleId String
  module   LitModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  slug     String    @unique              // 全局唯一，URL 末段
  title    String                         // 官方课程标题（元信息，非正文）
  order    Int       @default(0)

  // —— 来源区分 ——
  source   String    @default("official") // official|original|ugc

  // —— 官方桥接元信息（source=official 时必填，其余留空） ——
  officialUrl      String?                // 国家平台课程直达 URL
  officialProvider String?  @default("国家中小学智慧教育平台")
  officialCourseId String?                // 平台侧课程标识，改版后据此重新定位
  officialColumn   String?  @default("学AI")
  stage            String?                // 学段：小学|初中|高中|通用
  durationMin      Int?                   // 官方标注时长

  // —— 本站原创导学（页面唯一正文来源，全部人工撰写） ——
  hook        String                      // 为什么这节值得花时间（≤80 字，卡片摘要）
  guideIntro  String                      // 导学正文：这节讲什么、教师视角该怎么听
  watchPoints String  @default("[]")      // JSON string[]，带着这几个问题看
  afterAction String                      // 看完立刻做什么（衔接 SOP 的过渡文案）
  editorNote  String?                     // 编辑点评：官方没讲但一线要注意的
  faq         String  @default("[]")      // JSON {q,a}[]，喂 FAQPage 结构化数据
  keywords    String  @default("[]")      // JSON string[]

  // —— 外链健康 ——
  linkStatus    String    @default("unchecked") // unchecked|ok|warn|broken
  linkCheckedAt DateTime?
  linkHttpCode  Int?
  linkFinalUrl  String?                   // 跟随重定向后的落点，与 officialUrl 不同即为改版信号
  linkFailCount Int       @default(0)     // 连续失败次数，抖动容错
  fallbackUrl   String?                   // 失效兜底：栏目列表页 / 平台站内搜索页（发布必填）
  archiveNote   String?                   // 失效时对用户的人工说明

  // —— 发布与计数 ——
  status         String    @default("draft") // draft|published
  publishedAt    DateTime?
  viewCount      Int       @default(0)
  officialClicks Int       @default(0)    // 外链点击缓存计数（北极星指标）
  usefulCount    Int       @default(0)    // 与 Useful(refType="lesson") 对齐
  collectCount   Int       @default(0)    // 与 Favorite(refType="lesson") 对齐

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sops      LitLessonSop[]

  @@index([moduleId, status, order])
  @@index([status, publishedAt])
  @@index([linkStatus])
  @@index([source])
}

// 伴学课 ←→ 站内 SOP 多对多。
// 外键打在 SopPath.id（真 FK，级联安全）；对外链接用 usageId || id 现算。
model LitLessonSop {
  id        String    @id @default(cuid())
  lessonId  String
  lesson    LitLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sopPathId String
  sopPath   SopPath   @relation(fields: [sopPathId], references: [id], onDelete: Cascade)
  order     Int       @default(0)
  reason    String?                       // 本站原创：为什么这条 SOP 接这节课

  @@unique([lessonId, sopPathId])
  @@index([sopPathId])
}

// 匿名/登录用户行为事件。高频写入，刻意不加外键、不进事务。
model EventLog {
  id        String   @id @default(cuid())
  name      String                        // lit_lesson_view | lit_official_click | ...
  refType   String                        // lesson|module|path|tool
  refId     String                        // 稳定可读标识：lesson/module 用 slug
  anonId    String?                       // 前端 localStorage UUID，不含个人信息
  userId    String?                       // 登录态才有，不建 FK（避免写放大）
  props     String   @default("{}")       // JSON，事件附加字段
  ua        String?                       // 截断 120 字符
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([refType, refId, createdAt])
  @@index([anonId, name, createdAt])      // 支撑去重
}

// 每日汇总。看板只读这张表，raw 表滚动保留 30 天。
model EventDaily {
  id      String @id @default(cuid())
  day     String                          // "2026-08-01"（SQLite 无 DATE 类型，存 ISO 字符串）
  name    String
  refType String
  refId   String
  count   Int    @default(0)
  uniques Int    @default(0)              // 按 anonId 去重

  @@unique([day, name, refType, refId])
  @@index([day])
}

// ---------------- 武汉教育赛事雷达（radar） ----------------
// 链路：wuhan-edu-event-radar 技能产出候选池 JSON → 本模块导入 → 人工过审 → 发布 → 前台读取。
//
// 合规基线（硬约束，不可放宽）：
//  - 发布对象的四道硬门槛（地域 / 对象 / 时效 / 信源层级 ≤3）在服务端强制复刻，不信任录入者；
//    「内容生产」归 radar.py，「内容审核」归本模块，前台只读已发布态。
//  - 一律软删除（status=archived + archiveReason），保留审计轨迹。

/// 期次 + 导入批次。定时任务一次运行 = 一个期次 = 一批导入；手工新增的条目挂到当前编辑期。
model RadarEdition {
  id            String   @id @default(cuid())
  runDate       String                        // 运行日 "2026-10-09"
  windowStart   String                        // 覆盖窗口起 "2026-10-12"
  windowEnd     String                        // 覆盖窗口止 "2026-10-18"
  title         String                        // 展示标题，如「2026 年第 41 周（10/12—10/18）」

  // —— 导入批次信息（手工新建的空白期次留空）——
  fileName      String?
  fileHash      String?  @unique              // 同一文件重复上传直接拦截
  schemaVersion String?
  rawMeta       String   @default("{}")       // 原始 meta JSON（保留来源全貌）
  totalCount    Int      @default(0)          // 本次上传总条数
  acceptedCount Int      @default(0)          // 通过硬门槛
  blockedCount  Int      @default(0)          // 被硬门槛拦截（同样入库，作门槛有效性证据）

  // —— 发布态 ——
  status        String   @default("draft")    // draft|published|hidden|rolled_back
  publishedAt   DateTime?
  publishedBy   String?
  note          String?                       // 人工备注（为什么整期下架等）

  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        RadarEvent[]

  @@index([status, runDate])
  @@index([runDate])
}

/// 单条活动。externalId 为技能侧 SHA1 去重键，跨周稳定，保证重复导入幂等。
model RadarEvent {
  id            String        @id @default(cuid())
  editionId     String?
  edition       RadarEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  externalId    String?                            // 技能产出 id；手工新增同样按名称生成，便于识别重复
  source        String        @default("radar")    // radar|manual

  // —— 业务字段（与技能 schema 对齐）——
  name          String
  organizer     String
  coOrganizer   String?
  audienceRaw   String
  grades        String        @default("[]")       // JSON string[]：primary|junior|senior
  roles         String        @default("[]")       // JSON string[]：student|teacher
  category      String        @default("general")  // english|stem|reading|arts|sports|general
  region        String        @default("wuhan")    // wuhan|hubei|district
  keyDate       String                             // "YYYY-MM-DD"，排序主轴
  keyDateType   String                             // signup_start|signup_deadline|event_start|event_end|event_result
  timeRange     String?
  location      String?
  fee           String        @default("unknown")  // free|paid|unknown
  signupMethod  String
  sourceUrl     String
  sourceName    String
  sourceTier    Int           @default(4)          // 1 红头文件 … 4 自媒体/群转发
  notes         String?
  siblings      String        @default("[]")       // JSON：同系列分项，导入时折叠

  // —— 打分（服务端按导入日复算，作「建议值」；人工可覆盖）——
  suggestedBucket String      @default("C")
  rScore        Float         @default(0)
  tScore        Float         @default(0)
  cScore        Float         @default(0)
  suggestedTotal Float        @default(0)
  bucket        String        @default("C")        // 人工最终档位（默认取建议值）
  totalScore    Float         @default(0)
  promoted      Boolean       @default(false)      // 主推保底提升标记（不外显）
  scoreOverridden Boolean     @default(false)      // 人工改过档位

  // —— 门槛校验（服务端强制，发布前复查）——
  gatePassed    Boolean       @default(true)
  gateCodes     String        @default("[]")       // JSON string[]：G0_FIELD_MISSING 等
  complianceNote String       @default("")

  // —— 白名单标注（信息字段，不参与门槛与打分）——
  // 服务端按内置名单重算，人工可修正（如省级备案名单未内置时）；
  // 判定规则与红线见 src/lib/radar/whitelist.ts
  activityType     String?                         // competition|non_competition，仅上游显式声明时落库
  whitelistStatus  String  @default("unknown")     // confirmed|not_listed|not_applicable|unknown
  whitelistScope   String?                         // national|provincial
  whitelistMatched String?                         // 命中的名单条目全称
  whitelistSeq     Int?                            // 名单序号
  whitelistBasis   String?                         // 判定依据（可核验，含匹配方式）
  whitelistManual  Boolean @default(false)         // 人工改过判定（留痕，与 scoreOverridden 同范式）

  // —— 发布态与软删除 ——
  status        String        @default("draft")    // draft|published|archived|blocked
  archiveReason String?
  archivedAt    DateTime?
  archivedBy    String?
  sortOrder     Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, bucket, keyDate])
  @@index([editionId, status])
  // 同一活动在**同一期次内**唯一（重复上传幂等）；跨期重复出现是正常的（赛程跨月），
  // 各期独立留痕，保证回滚一批不会牵连上一期，也保证历史期次记录完整。
  @@unique([editionId, externalId])
}
