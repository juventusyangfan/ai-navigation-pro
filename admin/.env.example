# 采集中心（/api/admin/collect）所需的 LLM 运行时
# 任意 OpenAI 兼容的 Chat Completions 端点；只改 base_url 即可切换到
# DeepSeek / 通义千问 / 智谱 GLM / Kimi(Moonshot) / 本地 Ollama 等。
# 需模型支持 response_format: { type: "json_object" }（JSON 模式）。
COLLECT_LLM_BASE_URL=https://api.deepseek.com
COLLECT_LLM_API_KEY=
COLLECT_LLM_MODEL=deepseek-v4-pro
# 若部署在公网，建议给采集接口加独立密钥校验（当前复用 admin RBAC：tools:read / tools:write）
# COLLECT_API_SECRET=

# --- 作文测评（zuowen）后台看板 ---
# admin 不存作文数据、也不持有正文解密密钥，只通过 zuowen 的内部接口读取。
# ZUOWEN_CRON_TOKEN 必须与 zuowen/.env 的 ZW_CRON_TOKEN 完全一致。
ZUOWEN_BASE_URL=http://127.0.0.1:3002
ZUOWEN_CRON_TOKEN=

# --- 英语听说测评（H5）后台额度看板 ---
# 额度判断在 H5 的 /api/quota/start 里，admin 只通过内部接口读写，不落副本。
# H5_INTERNAL_TOKEN 必须与 H5 server/.env 的 H5_INTERNAL_TOKEN 完全一致。
H5_BASE_URL=http://127.0.0.1:8787
H5_INTERNAL_TOKEN=
