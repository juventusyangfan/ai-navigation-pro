# 树蕙伴学 · 小学写作水平测评 —— 环境变量
#
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进版本库。
# 生产环境的真实值只写在服务器上，不要提交任何密钥。

# --- 数据库 ---
# 与 admin 各自独立一个库，互不影响
DATABASE_URL="file:./dev.db"

# --- 多模态模型 ---
# 任意 OpenAI 兼容的 Chat Completions 端点，需支持图片输入（image_url）。
# 当前默认 DeepSeek：deepseek-flash 即 V4.1 Flash，原生支持图片，一个 Key 同时做识图和评测。
# 换供应商只改这三行（通义 qwen-vl / 智谱 glm-4v 等同样兼容）。
ZW_LLM_BASE_URL=https://api.deepseek.com
ZW_LLM_API_KEY=
ZW_LLM_MODEL=deepseek-flash
ZW_LLM_TIMEOUT_MS=45000
# 是否关闭模型的"思考"（reasoning）。默认 1=关闭。
# 实测关闭后单次耗时从 2-10 秒降到 0.1-0.5 秒，评分排名不变、区分度反而更大。
# 换到不支持 thinking 参数的供应商（如部分国产网关）时，设为 0。
ZW_LLM_DISABLE_THINKING=1

# --- 正文加密密钥（必填）---
# 32 字节，生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 生产环境缺失会导致「拒绝入库」，这是有意的 fail-closed。
# 换密钥后旧记录将无法解密（报告仍可看，正文不可见），请勿随意更换。
ZW_TEXT_KEY=

# --- IP 哈希盐（建议改掉默认值）---
ZW_IP_SALT=

# --- 限额 ---
# 单设备每日可测次数（家长感知里的「免费体验次数」）
ZW_DAILY_LIMIT=3
# 全站每日总次数上限，兜底防止批量换 Cookie 刷
ZW_GLOBAL_DAILY_CAP=300

# --- 内部维护接口 ---
# GET /api/internal/reviews 需要带 x-cron-token 请求头。
# 未配置时该接口一律 401（默认关闭）。
ZW_CRON_TOKEN=

# --- 引流位（前端展示，可留空）---
# 服务号二维码与企微二维码图片放在 public/qr/ 下，
# 留空则只显示文字引导，不显示图片。
NEXT_PUBLIC_MP_QR=/qr/mp.png
NEXT_PUBLIC_WORK_QR=/qr/work.png
